    function updateOverlayCount(){const b=feedbackOverlay?.querySelector('#fb-export-btn');if(b)b.textContent=`📥 导出(${collectedFeedbacks.length})`;}
    function removeFeedbackOverlay(){if(feedbackOverlay){feedbackOverlay.remove();feedbackOverlay=null;}}
    function toggleFeedbackMode(){feedbackMode=!feedbackMode;if(feedbackMode){createFeedbackOverlay();document.body.style.cursor='crosshair';}else{removeFeedbackOverlay();document.body.style.cursor='';}}
    function exportFeedbacks() {
        if(!collectedFeedbacks.length){alert('⚠️ 暂无反馈');return;}
        const ts=new Date().toISOString().slice(0,19).replace(/[T:]/g,'-');
        const fn=`fb-feedback-${ts}.txt`;
        const c=`# FilterBlade 反馈\n# ${new Date().toLocaleString()}\n# ${collectedFeedbacks.length} 条\n\n`+collectedFeedbacks.map((f,i)=>`--- #${i+1} ---\n${f}`).join('\n\n');
        try{const b=new Blob([c],{type:'text/plain;charset=utf-8'});const u=URL.createObjectURL(b);const a=document.createElement('a');a.href=u;a.download=fn;document.body.appendChild(a);a.click();setTimeout(()=>{document.body.removeChild(a);URL.revokeObjectURL(u);},100);}catch(e){navigator.clipboard.writeText(c).then(()=>alert(`已复制到剪贴板\n文件名: ${fn}`)).catch(()=>prompt('请手动复制:',c));}
    }

    document.addEventListener('keydown',e=>{
        if(['INPUT','TEXTAREA','SELECT'].includes(e.target.tagName))return;
        if(matchesShortcut(e,feedbackShortcut)){e.preventDefault();e.stopImmediatePropagation();toggleFeedbackMode();}
        if(matchesShortcut(e,exportShortcut)){e.preventDefault();e.stopImmediatePropagation();exportFeedbacks();}
    },true);

    GM_registerMenuCommand(`🔍 反馈模式 (${gsd(feedbackShortcut)})`,toggleFeedbackMode);
    GM_registerMenuCommand(`📥 快捷导出 (${gsd(exportShortcut)})`,exportFeedbacks);
    GM_registerMenuCommand('⌨️ 自定义反馈键',()=>{const k=prompt(`当前: ${gsd(feedbackShortcut)}`,feedbackShortcut);if(k?.trim()){feedbackShortcut=k.trim();GM_setValue('fb_feedback_shortcut',feedbackShortcut);if(feedbackMode)updateOverlayContent();}});
    GM_registerMenuCommand('⌨️ 自定义导出键',()=>{const k=prompt(`当前: ${gsd(exportShortcut)}`,exportShortcut);if(k?.trim()&&k.trim()!==feedbackShortcut){exportShortcut=k.trim();GM_setValue('fb_export_shortcut',exportShortcut);if(feedbackMode)updateOverlayContent();}});

    document.addEventListener('click',e=>{
        if(!feedbackMode||e.target===feedbackOverlay||feedbackOverlay?.contains(e.target))return;
        e.preventDefault();e.stopPropagation();e.stopImmediatePropagation();
        const t=e.target;
        if(t.tagName==='A'){t.dataset.fbOrigHref=t.href;t.removeAttribute('href');setTimeout(()=>{if(t.dataset.fbOrigHref){t.href=t.dataset.fbOrigHref;delete t.dataset.fbOrigHref;}},100);}
        const text=(t.textContent||'').trim();
        if(!text||!/[a-zA-Z]/.test(text)){alert('⚠️ 无英文文本');return;}
        const info=[`[原文] ${text}`,`[标签] <${t.tagName.toLowerCase()}>`,`[类名] ${t.className||'(无)'}`,`[路径] ${getElementPath(t)}`].join('\n');
        collectedFeedbacks.push(info);GM_setValue('fb_collected_feedbacks',collectedFeedbacks);updateOverlayCount();
        const ob=t.style.backgroundColor;t.style.backgroundColor='#4caf50';t.style.transition='background-color 0.3s';
        setTimeout(()=>{t.style.backgroundColor=ob;},300);
    },true);

    function getElementPath(el){const p=[];let c=el,d=0;while(c&&c!==document.body&&d<5){let s=c.tagName.toLowerCase();if(c.id)s+=`#${c.id}`;else if(c.className&&typeof c.className==='string')s+=`.${c.className.split(/\s+/)[0]}`;p.unshift(s);c=c.parentElement;d++;}return p.join(' > ');}

    // ==================== 9. 初始化 (v5.9: 去抖200ms) ====================
    translateRoot(document.body);

    let debounceTimer = null;
    const pendingNodes = new Set();

    function flushPendingNodes() {
        for (const n of pendingNodes) {
            if (!n.isConnected) continue;
            if (n.nodeType === Node.ELEMENT_NODE) {
                // v5.9: 对动态节点也执行选择器预翻译
                applySelectorTranslations(n);
                mergeAdjacentTextNodes(n);
                n.querySelectorAll?.('*')?.forEach(el => mergeAdjacentTextNodes(el));
                translateRoot(n);
            } else if (n.nodeType === Node.TEXT_NODE) {
                translateNode(n);
            }
        }
        pendingNodes.clear();
    }

    new MutationObserver(mutations => {
        for (const m of mutations) {
            if (m.type === 'childList') {
                m.addedNodes.forEach(n => pendingNodes.add(n));
            } else if (m.type === 'characterData') {
                pendingNodes.add(m.target);
            }
        }
        // v5.9: 去抖 200ms，等待框架所有渲染批次完成
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(flushPendingNodes, 200);
    }).observe(document.body, { childList: true, subtree: true, characterData: true });
})();
