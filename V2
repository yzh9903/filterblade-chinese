        feedbackOverlay.querySelector('#fb-clear-btn')?.addEventListener('click',e=>{e.stopPropagation();if(confirm('清空所有反馈？')){collectedFeedbacks=[];GM_setValue('fb_collected_feedbacks',[]);updateOverlayCount();}});
        feedbackOverlay.querySelector('#fb-close-btn')?.addEventListener('click',e=>{e.stopPropagation();toggleFeedbackMode();});
    }
    function updateOverlayContent() {
        if(!feedbackOverlay) return;
        feedbackOverlay.innerHTML=`<span>🔍 反馈模式 | ${gsd(feedbackShortcut)} 切换 · ${gsd(exportShortcut)} 导出</span><button id="fb-export-btn" style="background:#fff;color:#ff9800;border:none;padding:4px 12px;border-radius:4px;cursor:pointer;font-size:13px;font-weight:bold;">📥 导出(${collectedFeedbacks.length})</button><button id="fb-clear-btn" style="background:transparent;color:#fff;border:1px solid #fff;padding:4px 12px;border-radius:4px;cursor:pointer;font-size:13px;">🗑️ 清空</button><button id="fb-close-btn" style="background:transparent;color:#fff;border:1px solid #fff;padding:4px 12px;border-radius:4px;cursor:pointer;font-size:13px;">✕</button>`;
