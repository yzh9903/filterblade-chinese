    // ==================== 6. 翻译引擎 (v5.9) ====================
    function normalizeText(text) {
        let t = text
            .replace(/[\u200B-\u200D\uFEFF]/g, '')
            .replace(/\u00A0/g, ' ')
            .replace(/[\r\n\t]+/g, ' ')
            .replace(/\s{2,}/g, ' ')
            .trim();
        t = fixStickyText(t);
        return t;
    }

    function stripToAlnum(text) { return text.replace(/[^a-zA-Z0-9]/g, '').toLowerCase(); }

    function safeReplace(text, key, replacement) {
        let result = '', lastIndex = 0, searchIndex = 0;
        while (true) {
            const idx = text.indexOf(key, searchIndex);
            if (idx === -1) break;
            const cb = idx > 0 ? text[idx - 1] : '';
            const ca = idx + key.length < text.length ? text[idx + key.length] : '';
            if ((!cb || !/[a-zA-Z0-9]/.test(cb)) && (!ca || !/[a-zA-Z0-9]/.test(ca))) {
                result += text.slice(lastIndex, idx) + replacement;
                lastIndex = idx + key.length;
            }
            searchIndex = idx + 1;
        }
        result += text.slice(lastIndex);
        return result;
    }

    const MERGED_DICT = { ...BASE_DICT, ...userDict };
    const NORMALIZED_DICT = {};
    const ALNUM_INDEX = {};
    const EXACT_SHORT_DICT = {};
    const SUFFIX_DICT = {};

    const SKIP_WORDS = new Set([
        'filterblade', 'neversink', 'poe', 'pathofexile', 'github',
        'adblock', 'javascript', 'discord', 'beta', 'patreon',
        'twitter', 'youtube', 'twitch', 'facebook', 'instagram',
        'reddit', 'tiktok'
    ]);

    for (const [key, value] of Object.entries(MERGED_DICT)) {
        const nk = normalizeText(key);
        NORMALIZED_DICT[nk] = value;
        const ak = stripToAlnum(nk);
        if (ak && !SKIP_WORDS.has(ak)) ALNUM_INDEX[ak] = value;
        if (/^[a-zA-Z]{1,5}$/.test(nk)) {
            EXACT_SHORT_DICT[nk.toLowerCase()] = value;
            SUFFIX_DICT[nk.toLowerCase()] = value;
        }
    }

    const SORTED_KEYS = Object.keys(NORMALIZED_DICT).sort((a, b) => b.length - a.length);
    const translatedNodes = new WeakSet();

    function getContextTranslation(normalizedText, element) {
        const rule = CONTEXT_RULES.find(r => r.word === normalizedText);
        if (!rule || !element) return null;
        for (const r of rule.rules) { if (element.closest(r.selector)) return r.translation; }
        return rule.fallback;
    }

    function mergeAdjacentTextNodes(parent) {
        if (!parent || !parent.childNodes) return;
        const childNodes = Array.from(parent.childNodes);
        for (let i = 0; i < childNodes.length; i++) {
            const node = childNodes[i];
            if (node.nodeType !== Node.TEXT_NODE) continue;
            if (translatedNodes.has(node)) continue;
            let merged = node.textContent;
            let j = i + 1;
            while (j < childNodes.length && childNodes[j].nodeType === Node.TEXT_NODE && !translatedNodes.has(childNodes[j])) {
                merged += childNodes[j].textContent;
                childNodes[j].textContent = '';
                translatedNodes.add(childNodes[j]);
                j++;
            }
            if (j > i + 1) node.textContent = merged;
        }
    }

    function translateTrailingEnglish(text) {
        const match = text.match(/^(.*[\u4e00-\u9fff].*?)\s+([a-zA-Z][a-zA-Z0-9\-]*)([.!?,;:]*)$/);
        if (!match) return text;
        const [, prefix, engWord, punctuation] = match;
        const lowerWord = engWord.toLowerCase();
        if (SUFFIX_DICT[lowerWord]) return prefix + ' ' + SUFFIX_DICT[lowerWord] + punctuation;
        return text;
    }

    /**
     * v5.9: 片段拼接翻译
     * 当单个 TextNode 内容太短且不匹配任何词典条目时，
     * 尝试拼接同一父元素下所有未翻译的兄弟 TextNode，整体匹配
     */
    function tryParentConcatTranslate(node) {
        const parent = node.parentElement;
        if (!parent || translatedNodes.has(node)) return false;

        // 收集父元素下所有未翻译的 TextNode
        const siblings = [];
        for (const child of parent.childNodes) {
            if (child.nodeType === Node.TEXT_NODE && !translatedNodes.has(child)) {
                siblings.push(child);
            }
        }
        if (siblings.length < 2) return false;

        // 拼接所有片段
        const concatenated = siblings.map(s => s.textContent).join('');
        const normalized = normalizeText(concatenated);
        if (!normalized || normalized.length < 10) return false;

        // 尝试匹配完整句子
        const lowerNorm = normalized.toLowerCase();
        let translation = null;

        // 精确匹配
        if (NORMALIZED_DICT[normalized]) {
            translation = NORMALIZED_DICT[normalized];
        } else if (EXACT_SHORT_DICT[lowerNorm]) {
            translation = EXACT_SHORT_DICT[lowerNorm];
        }

        // alnum 模糊匹配
        if (!translation && /^[a-zA-Z0-9\s\-_.,!?'"()]+$/.test(normalized)) {
            const alnumKey = stripToAlnum(normalized);
            if (alnumKey && ALNUM_INDEX[alnumKey]) translation = ALNUM_INDEX[alnumKey];
        }

        if (!translation) return false;

        // 将翻译结果写入第一个节点，清空其余节点
        siblings[0].textContent = translation;
        translatedNodes.add(siblings[0]);
        for (let i = 1; i < siblings.length; i++) {
            siblings[i].textContent = '';
            translatedNodes.add(siblings[i]);
        }
        return true;
    }

    function translateNode(node) {
        if (node.nodeType !== Node.TEXT_NODE) return;
        if (translatedNodes.has(node)) return;
        const parent = node.parentElement;
        if (!parent) return;
        if (['SCRIPT', 'STYLE', 'TEXTAREA', 'INPUT', 'NOSCRIPT'].includes(parent.tagName)) return;

        const rawText = node.textContent;
        const normalized = normalizeText(rawText);
        if (!normalized) return;

        let text = normalized;
        let changed = false;

        // Step 1: 精确短词全等匹配
        const lowerNorm = text.toLowerCase();
        if (EXACT_SHORT_DICT[lowerNorm]) {
            text = EXACT_SHORT_DICT[lowerNorm];
            changed = true;
        }

        // Step 2: 长key子串匹配
        if (!changed) {
            for (const key of SORTED_KEYS) {
                if (key.length <= 5 && /^[a-zA-Z]{1,5}$/.test(key)) continue;
                if (!text.includes(key)) continue;
                const ctxTrans = getContextTranslation(key, parent);
                const replacement = ctxTrans || NORMALIZED_DICT[key];
                if (replacement) {
                    const newText = safeReplace(text, key, replacement);
                    if (newText !== text) { text = newText; changed = true; }
                }
            }
        }

        // Step 3: alnum模糊回退
        if (!changed && text.length < 80 && /^[a-zA-Z0-9\s\-_]+$/.test(text.trim())) {
            const alnumKey = stripToAlnum(text);
            if (alnumKey && ALNUM_INDEX[alnumKey]) { text = ALNUM_INDEX[alnumKey]; changed = true; }
        }

        // Step 4: 后缀剥离翻译
        if (!changed && /[\u4e00-\u9fff]/.test(text) && /[a-zA-Z]{2,}/.test(text)) {
            const newText = translateTrailingEnglish(text);
            if (newText !== text) { text = newText; changed = true; }
        }

        // v5.9 Step 5: 片段拼接翻译（兜底）
        if (!changed && text.length < 60) {
            if (tryParentConcatTranslate(node)) return; // 已由拼接处理
        }

        if (changed) {
            node.textContent = text;
            translatedNodes.add(node);
        }
    }

    /**
     * v5.9: CSS 选择器预翻译
     * 在所有文本遍历之前执行，直接定位顽固节点
     */
    function applySelectorTranslations(root) {
        for (const entry of SELECTOR_TRANSLATIONS) {
            try {
                const elements = root.querySelectorAll(entry.selector);
                for (const el of elements) {
                    if (entry.textMatch) {
                        // 文本内容匹配模式
                        const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null, false);
                        while (walker.nextNode()) {
                            const tn = walker.currentNode;
                            if (translatedNodes.has(tn)) continue;
                            const raw = normalizeText(tn.textContent);
                            if (entry.textMatch.test(raw)) {
                                tn.textContent = entry.replacement;
                                translatedNodes.add(tn);
                            }
                        }
                    } else if (entry.text !== undefined) {
                        // 直接文本替换模式
                        const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null, false);
                        while (walker.nextNode()) {
                            const tn = walker.currentNode;
                            if (translatedNodes.has(tn)) continue;
                            const raw = normalizeText(tn.textContent);
                            if (raw && /[a-zA-Z]/.test(raw)) {
                                tn.textContent = entry.text;
                                translatedNodes.add(tn);
                                break; // 只替换第一个文本节点
                            }
                        }
                    }
                }
            } catch (e) { /* 选择器无效时静默跳过 */ }
        }
    }

    function translateRoot(root) {
        // v5.9: 先执行选择器预翻译
        if (root.nodeType === Node.ELEMENT_NODE) {
            applySelectorTranslations(root);
            mergeAdjacentTextNodes(root);
            root.querySelectorAll('*').forEach(el => mergeAdjacentTextNodes(el));
        }

        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null, false);
        const nodes = [];
        while (walker.nextNode()) nodes.push(walker.currentNode);
        nodes.forEach(translateNode);
    }

    // ==================== 7. 🔍 词典一致性自动诊断引擎 ====================
    function runSelfDiagnostic() {
        const report = [];
        const ts = new Date().toLocaleString();
        report.push(`# FilterBlade 词典一致性诊断报告`, `# 生成时间: ${ts}`, `# 脚本版本: 5.9`, '');

        report.push('## [检查1] 词典Key清洗一致性');
        let ki = 0;
        for (const [ok] of Object.entries(MERGED_DICT)) { if (normalizeText(ok) !== ok) { ki++; report.push(`⚠️ "${ok}" → "${normalizeText(ok)}"`); } }
        report.push(ki === 0 ? '✅ 全部一致' : `${ki} 个不一致`, '');

        report.push('## [检查2] DOM未翻译英文文本');
        const w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
        let uc = 0;
        const SKIP_TAGS = ['SCRIPT','STYLE','TEXTAREA','INPUT','CODE','PRE','NOSCRIPT'];
        while (w.nextNode()) {
            const n = w.currentNode, p = n.parentElement;
            if (!p || SKIP_TAGS.includes(p.tagName) || translatedNodes.has(n)) continue;
            const raw = n.textContent;
            if (!raw || !/[a-zA-Z]{2,}/.test(raw)) continue;
            const cl = normalizeText(raw);
            if (!cl || !/[a-zA-Z]{2,}/.test(cl)) continue;
            if (SKIP_WORDS.has(stripToAlnum(cl))) continue;
            uc++;
            if (uc <= 30) report.push(`[${uc}] "${cl.substring(0,80)}" <${p.tagName.toLowerCase()}>`);
        }
        report.push(uc === 0 ? '✅ 无未翻译文本' : `共 ${uc} 处`, '');

        report.push('## [检查3] 已翻译节点英文残留');
        const ALLOWED = new Set(['FilterBlade','PoE','NeverSink','BD','SSF','UI','Discord','AdBlock','JavaScript','BEFORE','AFTER','GitHub','Patreon','Twitter','YouTube','Twitch']);
        const tw = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
        let hc = 0;
        while (tw.nextNode()) {
            const n = tw.currentNode, p = n.parentElement;
            if (!p || !translatedNodes.has(n)) continue;
            const t = n.textContent;
            if (!/[\u4e00-\u9fff]/.test(t) || !/[a-zA-Z]{3,}/.test(t)) continue;
            const words = t.match(/[a-zA-Z][a-zA-Z0-9\-]{2,}/g) || [];
            const bad = words.filter(w => !ALLOWED.has(w) && !ALLOWED.has(w.replace(/s$/,'')));
            if (bad.length) { hc++; if (hc<=20) report.push(`[${hc}] ${bad.join(',')} | "${t.substring(0,80)}"`); }
        }
        report.push(hc === 0 ? '✅ 无异常混杂' : `共 ${hc} 处`, '');

        report.push(`## 汇总: Key=${ki}, 未翻译=${uc}, 混杂=${hc}`);
        console.group('🔍 FilterBlade v5.9 诊断'); console.log(report.join('\n')); console.groupEnd();

        const fn = `fb-diag-${new Date().toISOString().slice(0,19).replace(/[T:]/g,'-')}.txt`;
        try {
            const b = new Blob([report.join('\n')], {type:'text/plain;charset=utf-8'});
            const u = URL.createObjectURL(b); const a = document.createElement('a');
            a.href=u; a.download=fn; document.body.appendChild(a); a.click();
            setTimeout(()=>{document.body.removeChild(a);URL.revokeObjectURL(u);},100);
            alert(`✅ v5.9诊断\nKey=${ki} 未翻译=${uc} 混杂=${hc}\n${fn}`);
        } catch(e) { alert(`✅ 诊断完成(F12查看)\nKey=${ki} 未翻译=${uc} 混杂=${hc}`); }
    }
    GM_registerMenuCommand('🔍 词典一致性自检', runSelfDiagnostic);

    // ==================== 8. 反馈系统 ====================
    let feedbackMode = false, feedbackOverlay = null;
    let collectedFeedbacks = GM_getValue('fb_collected_feedbacks', []);
    let feedbackShortcut = GM_getValue('fb_feedback_shortcut', 'Alt+F1');
    let exportShortcut = GM_getValue('fb_export_shortcut', 'Alt+F3');

    function parseShortcut(s) {
        const p = s.trim().split('+').map(x=>x.trim().toLowerCase());
        return { alt:p.includes('alt'), ctrl:p.includes('ctrl')||p.includes('control'),
                 shift:p.includes('shift'), meta:p.includes('meta')||p.includes('cmd'),
                 key:p.filter(x=>!['alt','ctrl','control','shift','meta','cmd','command'].includes(x))[0]||'' };
    }
    function matchesShortcut(e,s) {
        const p=parseShortcut(s); if(!p.key) return false;
        const km=e.key.toLowerCase()===p.key||e.code.toLowerCase()===p.key||e.code.toLowerCase()==='key'+p.key;
        return km&&e.altKey===p.alt&&e.ctrlKey===p.ctrl&&e.shiftKey===p.shift&&e.metaKey===p.meta;
    }
    function gsd(k){return k||'(未设置)';}

    function createFeedbackOverlay() {
        if(feedbackOverlay) return;
        feedbackOverlay=document.createElement('div');
        Object.assign(feedbackOverlay.style,{position:'fixed',top:'0',left:'0',right:'0',background:'#ff9800',color:'#fff',padding:'8px 16px',fontSize:'14px',zIndex:'2147483647',textAlign:'center',cursor:'pointer',fontFamily:'sans-serif',display:'flex',justifyContent:'center',alignItems:'center',gap:'16px',boxShadow:'0 2px 8px rgba(0,0,0,0.3)'});
        updateOverlayContent(); document.body.appendChild(feedbackOverlay);
    }
    function bindOverlayEvents() {
