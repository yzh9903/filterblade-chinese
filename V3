    function normalizeText(text) {
        let t = text.replace(/[\u200B-\u200D\uFEFF]/g, '').replace(/\u00A0/g, ' ')
            .replace(/[\r\n\t]+/g, ' ').replace(/\u2019/g, "'").replace(/\u2018/g, "'")
            .replace(/\s{2,}/g, ' ').trim();
        for (const [p, rep] of STICKY_FIXES) t = t.replace(p, rep);
        return t;
    }

    function stripToAlnum(text) { return text.replace(/[^a-zA-Z0-9]/g, '').toLowerCase(); }
    function isWhitelistedOnly(text) {
        const words = text.toLowerCase().match(/[a-z0-9]+/g) || [];
        return words.length > 0 && words.every(w => WHITELIST_WORDS.has(w));
