    // ==================== 6. 翻译引擎 (v7.0 原样保留) ====================
    const MERGED_DICT = { ...BASE_DICT, ...userDict };
    const NORMALIZED_DICT = {};
    const ALNUM_INDEX = {};
    const TRUNCATION_INDEX = {};

    for (const [key, value] of Object.entries(MERGED_DICT)) {
        const nk = normalizeText(key);
        NORMALIZED_DICT[nk] = value;
        const ak = stripToAlnum(nk);
        if (ak && !WHITELIST_WORDS.has(ak)) ALNUM_INDEX[ak] = value;
        if (nk.length > 25) TRUNCATION_INDEX[nk.substring(0, 40).toLowerCase()] = value;
    }

    const SORTED_KEYS = Object.keys(NORMALIZED_DICT).sort((a, b) => b.length - a.length);
    const translatedNodes = new WeakSet();
    const FB_ATTR = 'data-fb-translated';
    const FB_EXP_ATTR = 'data-fb-expected';

    const MODULE_FINGERPRINT = 'building blocks for filters';
    const MODULE_TRANSLATION = '模块是 filter 的构建块。如果您有多个 filter 使用相同的更改，可以将这些通用更改保存在一个模块中。您也可以在"我的模块"标签页中使用其他人的模块。';

    function getContextTranslation(text, el) {
        const rule = CONTEXT_RULES.find(r => r.word === text);
        if (!rule || !el) return null;
        for (const r of rule.rules) if (el.closest(r.selector)) return r.translation;
        return rule.fallback;
    }

    function mergeAdjacentTextNodes(parent) {
        if (!parent?.childNodes) return;
        const nodes = Array.from(parent.childNodes);
        for (let i = 0; i < nodes.length; i++) {
            const n = nodes[i];
            if (n.nodeType !== 3 || translatedNodes.has(n)) continue;
            let merged = n.textContent, j = i + 1;
            while (j < nodes.length && nodes[j].nodeType === 3 && !translatedNodes.has(nodes[j])) {
                merged += nodes[j].textContent; nodes[j].textContent = ''; translatedNodes.add(nodes[j]); j++;
            }
            if (j > i + 1) n.textContent = merged;
        }
    }

    function tryDomLevelFix(node) {
        const parent = node.parentElement;
        if (!parent || parent.hasAttribute(FB_ATTR)) return false;
        const fullText = normalizeText(parent.textContent || '');
        if (!fullText.includes(MODULE_FINGERPRINT)) return false;
        parent.textContent = MODULE_TRANSLATION;
        parent.setAttribute(FB_ATTR, '1'); parent.setAttribute(FB_EXP_ATTR, MODULE_TRANSLATION);
        const walker = document.createTreeWalker(parent, NodeFilter.SHOW_TEXT, null, false);
        while (walker.nextNode()) translatedNodes.add(walker.currentNode);
        return true;
    }

    function translateNode(node) {
        if (node.nodeType !== 3) return;
        const parent = node.parentElement;
        if (!parent || ['SCRIPT','STYLE','TEXTAREA','INPUT','NOSCRIPT'].includes(parent.tagName)) return;

        if (parent.hasAttribute(FB_ATTR)) {
            const exp = parent.getAttribute(FB_EXP_ATTR);
            if (exp && node.textContent !== exp && /[a-zA-Z]{2,}/.test(node.textContent)) {
                node.textContent = exp; translatedNodes.add(node);
            }
            return;
        }
        if (translatedNodes.has(node)) return;

        const normalized = normalizeText(node.textContent);
        if (!normalized) return;
        if (isWhitelistedOnly(normalized)) { translatedNodes.add(node); return; }

        if (normalized.includes('building') || normalized.includes('blocks')) {
            if (tryDomLevelFix(node)) return;
        }

        let text = normalized, changed = false;

        if (NORMALIZED_DICT[text]) { text = NORMALIZED_DICT[text]; changed = true; }

        if (!changed && text.length > 25) {
            const trunc = TRUNCATION_INDEX[text.substring(0, 40).toLowerCase()];
            if (trunc) { text = trunc; changed = true; }
        }

        if (!changed) {
            for (const key of SORTED_KEYS) {
                if (key.length <= 3 || !text.includes(key)) continue;
                const ctx = getContextTranslation(key, parent);
                const rep = ctx || NORMALIZED_DICT[key];
                if (!rep) continue;
                let res = '', last = 0, idx = 0;
                while ((idx = text.indexOf(key, last)) !== -1) {
                    const cb = idx > 0 ? text[idx-1] : '';
                    const ca = idx+key.length < text.length ? text[idx+key.length] : '';
                    if ((!cb || !/[a-zA-Z0-9]/.test(cb)) && (!ca || !/[a-zA-Z0-9]/.test(ca))) {
                        res += text.slice(last, idx) + rep; last = idx + key.length;
                    } else { res += text.slice(last, idx + key.length); last = idx + key.length; }
                }
                res += text.slice(last);
                if (res !== text) { text = res; changed = true; break; }
            }
        }

        if (!changed && text.length < 80 && /^[a-zA-Z0-9\s\-_]+$/.test(text)) {
            const ak = stripToAlnum(text);
            if (ALNUM_INDEX[ak]) { text = ALNUM_INDEX[ak]; changed = true; }
        }

        if (changed) {
            node.textContent = text; translatedNodes.add(node);
            parent.setAttribute(FB_ATTR, '1'); parent.setAttribute(FB_EXP_ATTR, text);
        }
    }

    function translateRoot(root) {
        if (root.nodeType === 1) {
            mergeAdjacentTextNodes(root);
            root.querySelectorAll('*').forEach(el => mergeAdjacentTextNodes(el));
        }
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null, false);
        const nodes = []; while (walker.nextNode()) nodes.push(walker.currentNode);
        nodes.forEach(translateNode);
    }

    // ==================== 7. 诊断引擎 (v7.0 原样保留) ====================
    function runSelfDiagnostic() {
        const report = [`# FilterBlade v7.0.1 诊断报告`, `# ${new Date().toLocaleString()}`, ''];
        report.push('## [检查1] 词典Key清洗一致性');
        let ki = 0;
        for (const [ok] of Object.entries(MERGED_DICT)) { if (normalizeText(ok) !== ok) { ki++; report.push(`⚠️ "${ok}"`); } }
        report.push(ki === 0 ? '✅ 全部一致' : `${ki} 个不一致`, '');

        report.push('## [检查2] DOM未翻译英文文本');
        const w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
        let uc = 0; const SKIP = ['SCRIPT','STYLE','TEXTAREA','INPUT','CODE','PRE','NOSCRIPT'];
        while (w.nextNode()) {
            const n = w.currentNode, p = n.parentElement;
            if (!p || SKIP.includes(p.tagName) || translatedNodes.has(n) || p.hasAttribute(FB_ATTR)) continue;
            const raw = normalizeText(n.textContent);
            if (!raw || !/[a-zA-Z]{2,}/.test(raw) || isWhitelistedOnly(raw)) continue;
            uc++; if (uc <= 30) report.push(`[${uc}] "${raw.substring(0,80)}" <${p.tagName.toLowerCase()}>`);
        }
        report.push(uc === 0 ? '✅ 无未翻译文本' : `共 ${uc} 处`, '');

        report.push('## [检查3] 已翻译节点英文残留');
        const tw = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
        let hc = 0;
        while (tw.nextNode()) {
            const n = tw.currentNode, p = n.parentElement;
            if (!p || !translatedNodes.has(n)) continue;
            const t = n.textContent;
            if (!/[\u4e00-\u9fff]/.test(t) || !/[a-zA-Z]{3,}/.test(t)) continue;
            const words = t.match(/[a-zA-Z][a-zA-Z0-9\-]{2,}/g) || [];
            const bad = words.filter(w => !WHITELIST_WORDS.has(w.toLowerCase()));
            if (bad.length) { hc++; if (hc<=20) report.push(`[${hc}] ${bad.join(',')} | "${t.substring(0,80)}"`); }
        }
        report.push(hc === 0 ? '✅ 无异常混杂' : `共 ${hc} 处`, '');
        report.push(`## 汇总: Key=${ki}, 未翻译=${uc}, 混杂=${hc}`);

        console.group('🔍 FilterBlade v7.0.1 诊断'); console.log(report.join('\n')); console.groupEnd();
        const fn = `fb-diag-v7.0.1-${Date.now()}.txt`;
        try {
            const b = new Blob([report.join('\n')], {type:'text/plain;charset=utf-8'});
            const u = URL.createObjectURL(b); const a = document.createElement('a');
            a.href=u; a.download=fn; document.body.appendChild(a); a.click();
            setTimeout(()=>{document.body.removeChild(a);URL.revokeObjectURL(u);},100);
            alert(`✅ v7.0.1诊断完成\nKey=${ki} 未翻译=${uc} 混杂=${hc}\n${fn}`);
        } catch(e) { alert(`✅ 诊断完成(F12查看)\nKey=${ki} 未翻译=${uc} 混杂=${hc}`); }
    }
    GM_registerMenuCommand('🔍 词典一致性自检', runSelfDiagnostic);

    // ==================== 8. 反馈系统 (v7.0 原样保留) ====================
    let feedbackMode = false, feedbackOverlay = null;
    let collectedFeedbacks = GM_getValue('fb_collected_feedbacks', []);

    function toggleFeedbackMode() {
        feedbackMode = !feedbackMode;
        if (feedbackMode) {
            if (!feedbackOverlay) {
                feedbackOverlay = document.createElement('div');
                Object.assign(feedbackOverlay.style, {
                    position:'fixed', top:'0', left:'0', right:'0', background:'#ff9800',
                    color:'#fff', padding:'8px 16px', fontSize:'14px', zIndex:'2147483647',
                    textAlign:'center', display:'flex', justifyContent:'center', alignItems:'center', gap:'16px'
                });
                feedbackOverlay.innerHTML = `<span>🔍 反馈模式已开启</span><button onclick="this.parentElement.remove()" style="background:#fff;color:#ff9800;border:none;padding:4px 12px;border-radius:4px;cursor:pointer;">✕ 关闭</button>`;
                document.body.appendChild(feedbackOverlay);
            }
            document.body.style.cursor = 'crosshair';
        } else { feedbackOverlay?.remove(); feedbackOverlay = null; document.body.style.cursor = ''; }
    }

    document.addEventListener('click', e => {
        if (!feedbackMode || e.target === feedbackOverlay || feedbackOverlay?.contains(e.target)) return;
        e.preventDefault(); e.stopPropagation();
        const t = e.target, text = (t.textContent||'').trim();
        if (!text || !/[a-zA-Z]/.test(text)) return;
        collectedFeedbacks.push(`[${new Date().toLocaleTimeString()}] ${text} | <${t.tagName.toLowerCase()}> | ${t.className}`);
        GM_setValue('fb_collected_feedbacks', collectedFeedbacks);
        t.style.outline = '2px solid #4caf50'; setTimeout(() => t.style.outline = '', 500);
    }, true);

    GM_registerMenuCommand('🔍 切换反馈模式', toggleFeedbackMode);
    GM_registerMenuCommand('📥 导出反馈', () => {
        if (!collectedFeedbacks.length) return alert('暂无反馈');
        navigator.clipboard.writeText(collectedFeedbacks.join('\n')).then(() => alert(`已复制 ${collectedFeedbacks.length} 条反馈`));
    });

    // ==================== 9. 初始化 (v7.0 原样保留) ====================
    registerShortcutPanel();
    bindShortcuts();
    translateRoot(document.body);
    let debounceTimer = null; const pending = new Set();
    new MutationObserver(ms => {
        for (const m of ms) if (m.type === 'childList') m.addedNodes.forEach(n => pending.add(n));
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
            for (const n of pending) {
                if (!n.isConnected) continue;
                if (n.nodeType === 1) translateRoot(n); else if (n.nodeType === 3) translateNode(n);
            }
            pending.clear();
        }, 300);
    }).observe(document.body, { childList: true, subtree: true });
    window.addEventListener('load', () => setTimeout(() => translateRoot(document.body), 500));
})();
