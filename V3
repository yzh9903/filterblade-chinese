    function registerShortcutPanel() {
        GM_registerMenuCommand('⌨️ 自定义快捷键', () => {
            const current = JSON.stringify(ACTIVE_SHORTCUTS, null, 2);
            const input = prompt(
                '自定义快捷键配置 (JSON格式)\n支持: Ctrl, Shift, Alt + 字母/数字/F键\n例: {"toggleFeedback": {"key":"F9","desc":"切换反馈模式"}}',
                current
            );
            if (input !== null) {
                try {
                    const parsed = JSON.parse(input);
                    GM_setValue('fb_user_shortcuts', parsed);
                    alert('✅ 快捷键已保存，刷新生效');
                    location.reload();
                } catch (e) { alert('❌ JSON格式错误: ' + e.message); }
            }
        });
    }

    function bindShortcuts() {
        document.addEventListener('keydown', (e) => {
            const tag = e.target.tagName;
            if (['INPUT', 'TEXTAREA', 'SELECT'].includes(tag)) return;
            const mods = [];
            if (e.ctrlKey) mods.push('Ctrl');
            if (e.shiftKey) mods.push('Shift');
            if (e.altKey) mods.push('Alt');
            const keyName = e.key.length === 1 ? e.key.toUpperCase() : e.key;
            const combo = [...mods, keyName].join('+');
            for (const [action, cfg] of Object.entries(ACTIVE_SHORTCUTS)) {
                if (cfg.key && cfg.key.toUpperCase() === combo.toUpperCase()) {
                    e.preventDefault(); e.stopPropagation();
                    switch (action) {
                        case 'toggleFeedback': toggleFeedbackMode(); break;
                        case 'runDiagnostic': runSelfDiagnostic(); break;
                        case 'openCustomDict':
                            document.querySelector('[data-fb-menu="customDict"]')?.click(); break;
                        case 'quickSave':
                            document.querySelector('.saveBtn, [class*="save"]')?.click(); break;
                        case 'focusSearch':
                            document.querySelector('input[type="search"], .searchInput, #searchBar')?.focus(); break;
                    }
                    console.log(`[FB] 快捷键触发: ${combo} -> ${action}`);
                    return;
                }
            }
        }, true);
    }

