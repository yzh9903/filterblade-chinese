            { selector: '.gem-level-input, [class*="gemLevel"]', translation: '宝石等级' },
            { selector: '.drop-level-input, [class*="dropLevel"]', translation: '掉落等级' },
            { selector: '.item-level-input, [class*="itemLevel"]', translation: '物品等级' },
            { selector: '.area-level-input, [class*="areaLevel"]', translation: '区域等级' }
        ], fallback: '等级' },
        { word: 'Type', rules: [
            { selector: '.base-type-selector, [class*="baseType"]', translation: '基础类型' },
            { selector: '.item-class-selector, [class*="itemClass"]', translation: '物品类别' }
        ], fallback: '类型' },
        { word: 'Color', rules: [
            { selector: '.text-color-picker, [class*="textColor"]', translation: '文字颜色' },
            { selector: '.bg-color-picker, [class*="backgroundColor"], [class*="bgColor"]', translation: '背景颜色' },
            { selector: '.border-color-picker, [class*="borderColor"]', translation: '边框颜色' }
        ], fallback: '颜色' },
        { word: 'Sound', rules: [
            { selector: '.sound-picker, [class*="soundSelect"]', translation: '播放音效' },
            { selector: '.disable-sound-toggle, [class*="disableSound"]', translation: '禁用掉落音效' }
        ], fallback: '音效' }
    ];

    // ==================== 3. 用户自定义词典支持 ====================
    let userDict = {};
    try { userDict = GM_getValue('filterblade_user_dict', {}); } catch (e) {}

    GM_registerMenuCommand('📝 编辑自定义词典', () => {
        const input = prompt(
            '请输入自定义翻译（JSON格式）:\n例: {"New Word": "新词翻译"}',
            JSON.stringify(userDict)
        );
        if (input !== null) {
            try {
                const parsed = JSON.parse(input);
                GM_setValue('filterblade_user_dict', parsed);
                alert('✅ 自定义词典已保存，刷新页面生效');
                location.reload();
            } catch (e) { alert('❌ JSON格式错误: ' + e.message); }
        }
    });

    // ==================== 4. 文本归一化工具（核心修复） ====================
    function normalizeText(text) {
        return text
            .replace(/[\u200B-\u200D\uFEFF]/g, '')       // 移除零宽字符
            .replace(/\u00A0/g, ' ')                      // 不间断空格 → 普通空格
            .replace(/[\r\n\t]+/g, ' ')                   // 换行/制表符 → 空格
            .replace(/\s{2,}/g, ' ')                      // 多空格合并
            .trim();
    }

    // 构建归一化后的词典映射（避免每次翻译都重复归一化）
    const NORMALIZED_DICT = {};
    const ORIGINAL_KEYS = {};
    for (const [key, value] of Object.entries(BASE_DICT)) {
        const nk = normalizeText(key);
        NORMALIZED_DICT[nk] = value;
        ORIGINAL_KEYS[nk] = key;
    }
    // 合并用户词典
    for (const [key, value] of Object.entries(userDict)) {
        const nk = normalizeText(key);
        NORMALIZED_DICT[nk] = value;
        ORIGINAL_KEYS[nk] = key;
    }
    const SORTED_NORMALIZED_KEYS = Object.keys(NORMALIZED_DICT).sort((a, b) => b.length - a.length);

    const TRANSLATED_ATTR = 'data-fb-translated';

    function getContextTranslation(normalizedText, element) {
        const rule = CONTEXT_RULES.find(r => r.word === normalizedText);
        if (!rule || !element) return null;
        for (const r of rule.rules) {
            if (element.closest(r.selector)) return r.translation;
        }
        return rule.fallback;
    }

    function translateNode(node) {
        if (node.nodeType !== Node.TEXT_NODE) return;
        const parent = node.parentElement;
        if (!parent) return;
        if (parent.hasAttribute(TRANSLATED_ATTR)) return;
        if (['SCRIPT', 'STYLE', 'TEXTAREA', 'INPUT'].includes(parent.tagName)) return;

        const rawText = node.textContent;
        const normalized = normalizeText(rawText);
        if (!normalized) return;

        let text = normalized;
        let changed = false;

        for (const key of SORTED_NORMALIZED_KEYS) {
            if (!text.includes(key)) continue;
            const ctxTrans = getContextTranslation(key, parent);
            const replacement = ctxTrans || NORMALIZED_DICT[key];
            if (replacement && text.includes(key)) {
                text = text.split(key).join(replacement);
                changed = true;
            }
        }

        if (changed) {
            node.textContent = text;
            parent.setAttribute(TRANSLATED_ATTR, '1');
        }
    }

    function translateRoot(root) {
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null, false);
        const nodes = [];
        while (walker.nextNode()) nodes.push(walker.currentNode);
        nodes.forEach(translateNode);
    }

    // ==================== 5. 点击提取未翻译文本功能 ====================
    let feedbackMode = false;
    let feedbackOverlay = null;

    function createFeedbackOverlay() {
        if (feedbackOverlay) return;
        feedbackOverlay = document.createElement('div');
        Object.assign(feedbackOverlay.style, {
            position: 'fixed', top: '0', left: '0', right: '0',
            background: '#ff9800', color: '#fff', padding: '8px 16px',
            fontSize: '14px', zIndex: '999999', textAlign: 'center',
            cursor: 'pointer', fontFamily: 'sans-serif'
        });
        feedbackOverlay.textContent = '🔍 反馈模式已开启 | 点击任意未翻译文本提取信息 | 再次点击此栏关闭';
        feedbackOverlay.addEventListener('click', toggleFeedbackMode);
        document.body.appendChild(feedbackOverlay);
    }

    function removeFeedbackOverlay() {
        if (feedbackOverlay) { feedbackOverlay.remove(); feedbackOverlay = null; }
    }

    function toggleFeedbackMode() {
        feedbackMode = !feedbackMode;
        if (feedbackMode) {
            createFeedbackOverlay();
            document.body.style.cursor = 'crosshair';
        } else {
            removeFeedbackOverlay();
            document.body.style.cursor = '';
        }
    }

    GM_registerMenuCommand('🔍 切换未翻译文本提取模式', toggleFeedbackMode);

    document.addEventListener('click', (e) => {
        if (!feedbackMode) return;
        if (e.target === feedbackOverlay) return;

        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();

        const target = e.target;
        if (target.tagName === 'A') {
            target.dataset.fbOriginalHref = target.href;
            target.removeAttribute('href');
            setTimeout(() => {
                if (target.dataset.fbOriginalHref) {
                    target.href = target.dataset.fbOriginalHref;
                    delete target.dataset.fbOriginalHref;
                }
            }, 100);
        }

        const text = (target.textContent || '').trim();
        if (!text || !/[a-zA-Z]/.test(text)) {
            alert('⚠️ 该位置未检测到英文文本');
            return;
        }

        const info = [
            `[原文] ${text}`,
            `[标签] <${target.tagName.toLowerCase()}>`,
            `[类名] ${target.className || '(无)'}`,
            `[父级] <${target.parentElement?.tagName.toLowerCase()}> .${target.parentElement?.className || '(无)'}`,
            `[路径] ${getElementPath(target)}`
        ].join('\n');

        navigator.clipboard.writeText(info).then(() => {
            alert(`✅ 已复制到剪贴板:\n\n${info}`);
        }).catch(() => {
            const ta = document.createElement('textarea');
            ta.value = info;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            ta.remove();
            alert(`✅ 已复制到剪贴板:\n\n${info}`);
        });
    }, true);

    function getElementPath(el) {
        const parts = [];
        let current = el;
        let depth = 0;
        while (current && current !== document.body && depth < 5) {
            let desc = current.tagName.toLowerCase();
            if (current.id) desc += `#${current.id}`;
            else if (current.className && typeof current.className === 'string') {
                desc += `.${current.className.split(/\s+/)[0]}`;
            }
            parts.unshift(desc);
            current = current.parentElement;
            depth++;
        }
        return parts.join(' > ');
    }

    // ==================== 6. 初始化与动态监听 ====================
    translateRoot(document.body);

    const observer = new MutationObserver(mutations => {
        for (const mutation of mutations) {
            if (mutation.type === 'childList') {
                mutation.addedNodes.forEach(node => {
                    if (node.nodeType === Node.ELEMENT_NODE) translateRoot(node);
                    else if (node.nodeType === Node.TEXT_NODE) translateNode(node);
                });
            } else if (mutation.type === 'characterData') {
                translateNode(mutation.target);
            }
        }
    });

    observer.observe(document.body, { childList: true, subtree: true, characterData: true });
})();
